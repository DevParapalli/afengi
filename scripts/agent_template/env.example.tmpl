# Framework parameters (non-secret; shared by every agent).
APP_NAME={{AGENT_SLUG}}
ENVIRONMENT=prod
HOST=0.0.0.0
PORT=8080
# Full SQLAlchemy URL, passed straight to create_engine (no further escaping).
# Empty = persistence & telemetry disabled.
#   Shape:      dialect+driver://USER:PASSWORD@HOST:PORT/NAME
#   SQLite:     sqlite:///./agent.db   (stdlib; set DB_AUTO_CREATE=true so tables are created)
#   PostgreSQL: postgresql+psycopg://user:pw@host:5432/mydb   (uv sync --extra postgres)
#   Oracle:     oracle+oracledb://user:pw@host:1521/?service_name=svc   (uv sync --extra oracle)
# Percent-encode (quote_plus) ONLY the username and password if they contain
# reserved chars (@ : / ? # % ...); do not encode the whole string.
DB_URL=
# Optional (default shown) -- uncomment only to override.
# DB_ECHO=false
# Schema control. Prod default false: framework never issues DDL -- provision the
# schema externally (see db/postgresql.sql, db/oracle.sql). Set true only for
# local/dev or SQLite to let init_db() create tables from the ORM models.
# DB_AUTO_CREATE=false
# Table naming. TABLE_PREFIX is the ONE lever most deployments need: it prepends
# <prefix>_ to every table + index (e.g. an agent name -> acme_decision_state). Leave
# empty for base names verbatim.
TABLE_PREFIX=
# Per-table name overrides (optional; defaults shown). Only to bind to a DBA-
# provisioned schema whose names don't follow the <prefix>_<base> pattern.
# DECISION_STATE_TABLE=decision_state
# TELEMETRY_API_REQUEST_TABLE=telemetry_api_request
# TELEMETRY_MODEL_CALL_TABLE=telemetry_model_call
# Comma-separated valid X-API-KEY values for the HTTP endpoints.
# EMPTY + no OIDC_ISSUER = endpoint auth DISABLED (serve() warns loudly at startup).
API_KEYS=
# Comma-separated hosts / URL prefixes the framework's generic HTTP tools may reach
TOOL_URL_ALLOWLIST=
# MCP protocol 2026-07-28 (stateless); mcp_toolset() refuses to build without it.
# Baked into both Dockerfiles. pydantic does not export .env to the process, so a
# local run needs `uv run --env-file .env main.py` for ADK to see it.
ADK_ENABLE_MCP_MODERN_PROTOCOL=1


# LLM gateway (OpenAI-compatible).
LLM_BASE_URL={{LLM_BASE_URL}}
LLM_TOKEN_URL={{LLM_TOKEN_URL}}
LLM_CLIENT_ID=
LLM_CLIENT_SECRET=
LLM_IDENTIFIER=
MODEL={{MODEL}}

{{CONNECTION_ENV}}
{{MCP_ENV}}
